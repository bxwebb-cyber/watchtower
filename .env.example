# Watchtower — environment (copy to .env and fill)
# NEVER commit .env

# Server
PORT=4000

# Postgres
DATABASE_URL="postgresql://localhost:5432/watchtower"

# Stripe (the user's platform account for OAuth + webhook verification)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Your app's Stripe connect OAuth (for letting users connect their Stripe)
STRIPE_CLIENT_ID="ca_..."
STRIPE_REDIRECT_URI="http://localhost:4000/auth/stripe/callback"

# Email (Resend)
RESEND_API_KEY="re_..."

# Outbound "from" address for reminders + owner alerts, and the inbound
# reply-to domain. PLACEHOLDERS until the real sending domain is bought.
# Inbound replies land at reply-<invoiceId>@<SENDING_DOMAIN>.
MAIL_FROM="Watchtower <reminders@your-domain.com>"
SENDING_DOMAIN="your-domain.com"

# App
APP_URL="http://localhost:4000"
SESSION_SECRET="change-me"
