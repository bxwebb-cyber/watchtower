// Watchtower data model
// Prisma schema — the agent's memory: every invoice it watches, every
// reminder it sent, every fee it applied, and the proof (audit trail).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A business that connected their Stripe account to Watchtower
model Account {
  id               String   @id @default(cuid())
  stripeAccountId  String   @unique // the connected Stripe account id (acct_...)
  email            String
  businessName     String?
  ownerName        String?  // the owner's own name — emails sign off "Reply to reach <first name>"
  passwordHash     String?  // set on first login; null before setup
  createdAt        DateTime @default(now())

  // Subscription billing (what the owner pays Dunn, separate from their
  // connected Stripe account which is the merchant-of-record for invoices).
  stripeCustomerId    String?   @unique // Stripe billing Customer (this account as a subscriber)
  plan                String?   // "solo" | "business" | null
  stripeSubscriptionId String?  @unique
  subscriptionStatus  String?   // "active" | "trialing" | "past_due" | "canceled" | "incomplete" | "incomplete_expired" | "unpaid"
  currentPeriodEnd    DateTime? // when the current billing period ends
  cancelAtPeriodEnd   Boolean   @default(false)

  invoices Invoice[]
  clients  Client[]
  fees     FeePolicy[]
  settings Settings?
  templates InvoiceTemplate[]
}

// A customer of the business (mirrored from Stripe)
model Client {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  stripeCustomerId String @unique
  name        String
  email       String?
  createdAt   DateTime @default(now())

  invoices Invoice[]
}

// The fee terms the business owner set at invoice creation
model FeePolicy {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  // "flat" | "percent" | "none"
  kind       String
  // flat: dollars; percent: 0-100
  amount     Float
  // days after due date before the fee applies
  graceDays  Int      @default(7)
  createdAt  DateTime @default(now())

  invoice Invoice?
}

// One invoice Watchtower is watching
model Invoice {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  stripeInvoiceId String   @unique
  stripeNumber    String?  // human-facing invoice number (e.g. HUDSON-0007)
  hostedInvoiceUrl String? // the real Stripe payment link for the client
  amount          Int // cents
  currency        String   @default("usd")
  dueDate         DateTime
  status          String   @default("open") // open | paid | void | uncollectible
  feePolicyId     String?   @unique
  feePolicy       FeePolicy? @relation(fields: [feePolicyId], references: [id])
  feeApplied      Boolean  @default(false)
  feeInvoiceId    String? // the stripe invoice id of the late-fee invoice
  feeAmountCents  Int?     // the late-fee amount in cents (mirrors the fee invoice)
  feeIssuedAt     DateTime? // when the fee invoice was created
  feeDueDate      DateTime? // the fee invoice's own due date
  feeStatus       String?  // "open" | "paid" (null = no fee on this invoice)
  feePaidAt       DateTime? // when the fee invoice was paid
  paidAt          DateTime?
  repliedAt       DateTime? // when the client replied — pauses reminders
  escalateAction  String?   // null | "send_reminder" | "owner_calling" — owner's decision at escalation
  waiveNote       String?   // owner's reason for waiving the late fee
  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt

  reminders Reminder[]
  replies   Reply[]
  auditLog  AuditEvent[]
}

// A client's reply to a reminder, captured via inbound email.
// Reply-to addresses are per-invoice (reply-<invoiceId>@domain), so the
// inbound webhook matches the reply to exactly one invoice.
model Reply {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  from      String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// Every reminder email the agent sent (the proof)
model Reminder {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  step       String   // "t-7" | "t-3" | "due" | "t+3" | "t+7" | "t+14"
  sentAt     DateTime @default(now())
  subject    String
  messageId  String? // Resend message id
}

// The audit trail — everything the agent did, in order
model AuditEvent {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  event     String   // "invoice_created" | "reminder_sent" | "fee_applied" | "invoice_paid" ...
  detail    String?
  createdAt DateTime @default(now())
}

// Per-account preferences
model Settings {
  id           String   @id @default(cuid())
  accountId    String   @unique
  account      Account  @relation(fields: [accountId], references: [id])
  // email timing offsets (days before/after due date)
  remindT7     Boolean  @default(true)
  remindT3     Boolean  @default(true)
  remindDue    Boolean  @default(true)
  remindT3late Boolean  @default(true)
  remindT7late Boolean  @default(true)
  remindT14    Boolean  @default(true)
  // auto-apply fees after the first approval?
  autoApplyFees Boolean @default(false)
  // the owner's inbox — where client replies are forwarded and alerts go.
  // Falls back to the Stripe account email when unset.
  ownerEmail    String?
  // Alert toggles (owner email notifications)
  alertFeeApproval Boolean @default(true)  // a late fee needs my approval
  alertOverdue     Boolean @default(true)  // an invoice goes overdue
  alertPayment     Boolean @default(false) // a client pays
  // Default late-fee terms — prefill the invoice form + recurring templates.
  defaultFeeKind   String  @default("none") // "none" | "flat" | "percent"
  defaultFeeAmount Float   @default(0)      // flat: dollars; percent: 0-100
  defaultGraceDays Int     @default(7)      // days after due before the fee applies
  createdAt    DateTime @default(now())
}

// A recurring invoice template: set it once, Dunn auto-creates on schedule.
model InvoiceTemplate {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  clientName      String
  clientEmail     String
  amount          Int      // cents
  currency        String   @default("usd")
  dueDays         Int      @default(30) // days from today for the due date
  // Fee settings (denormalized — copied to each created invoice's FeePolicy)
  feeKind         String   @default("none") // "flat" | "percent" | "none"
  feeAmount       Float    @default(0)
  graceDays       Int      @default(7)
  // Schedule
  frequency       String   @default("monthly") // "monthly" | "weekly" | "biweekly" | "custom"
  customDay       Int?     // day of month for "custom" frequency (1-28)
  nextRunDate     DateTime // next date to create the invoice
  // Status
  active          Boolean  @default(true)
  lastRunAt       DateTime?
  lastRunOk       Boolean?  // whether the last run succeeded
  lastError       String?   // last error message if the run failed
  sentCount       Int      @default(0) // total invoices created from this template
  lastInvoiceId   String?  // the most recent invoice created from this template
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
